{
  "name": "@kaligula/desktop",
  "productName": "Kaligula",
  "version": "0.1.0-A",
  "private": true,
  "description": "Kaligula para escritorio (Windows): Electron ejecuta el servidor standalone de Next.js en local con una base de datos SQLite.",
  "author": "Kaligula Finance",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,desktop \"npm run dev -w @kaligula/web\" \"wait-on http://127.0.0.1:3000/api/health && electron .\"",
    "prepare:web": "node scripts/prepare-web.mjs",
    "dist:win": "npm run prepare:web && electron-builder --win nsis --x64",
    "dist": "npm run prepare:web && electron-builder"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.kaligula.finance",
    "productName": "Kaligula",
    "asar": true,
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web-dist",
        "to": "web",
        "filter": [
          "**/*",
          "**/.next/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../web/public/kaligula.ico",
      "artifactName": "Kaligula-0.1A-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "afterPack": "./scripts/after-pack.cjs",
    "copyright": "Copyright © 2026 Kaligula Finance",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../web/public/kaligula.ico",
      "uninstallerIcon": "../web/public/kaligula.ico",
      "installerHeaderIcon": "../web/public/kaligula.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kaligula",
      "uninstallDisplayName": "Kaligula 0.1A",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
