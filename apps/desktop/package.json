{
  "name": "@kaligula/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Kaligula para escritorio: Electron ejecuta el servidor standalone de Next.js en local.",
  "author": "Kaligula Finance",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,desktop \"npm run dev -w @kaligula/web\" \"wait-on http://127.0.0.1:3000/api/health && electron .\"",
    "prepare:web": "node scripts/prepare-web.mjs",
    "dist:win": "npm run prepare:web && electron-builder --win portable",
    "dist": "npm run prepare:web && electron-builder"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.kaligula.finance",
    "productName": "Kaligula",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web-dist",
        "to": "web",
        "filter": [
          "**/*",
          "**/.next/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "../web/public/kaligula.ico",
      "artifactName": "Kaligula-${version}-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "afterPack": "./scripts/after-pack.cjs"
  }
}
