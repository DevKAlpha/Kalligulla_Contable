{
  "name": "kaligula",
  "version": "0.4.0",
  "private": true,
  "description": "Kaligula, consola financiera personal: web (Next.js), escritorio (Electron) y API modular.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @kaligula/web",
    "build": "npm run build -w @kaligula/web",
    "start": "npm run start -w @kaligula/web",
    "api:dev": "npm run dev -w @kaligula/api",
    "desktop:dev": "npm run dev -w @kaligula/desktop",
    "desktop:win": "npm run build && npm run dist:win -w @kaligula/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "icons": "node scripts/generate-icons.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
