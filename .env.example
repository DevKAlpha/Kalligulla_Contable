# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection. Without it the app uses the embedded PGlite database in KALIGULA_DATA_DIR.
# DATABASE_URL=postgres://kaligula:change-me@localhost:5432/kaligula
# KALIGULA_DATA_DIR=./.data/pglite

# Password for the PostgreSQL container in docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Extra host names the API answers to (comma separated). Needed when serving under a domain or LAN IP.
# The app has no login yet: only expose it on networks you trust.
# KALIGULA_ALLOWED_HOSTS=kaligula.local,192.168.1.20

# Live exchange rates: refresh interval (seconds, min 15) and optional AwesomeAPI key for higher quotas.
# FX_REFRESH_SECONDS=60
# AWESOMEAPI_KEY=

# News feeds (central banks and economic outlets). Set to "off" to make no requests to news sites.
# KALIGULA_NEWS=off

# Optional CoinGecko demo key for higher rate limits on the crypto ranking.
# COINGECKO_API_KEY=

# Free Alpaca Market Data keys: official, real-time stock and ETF prices (see README).
# Without them the ranking falls back to Yahoo Finance's unofficial, possibly delayed data.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
