    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@kaligula/contracts": "0.4.0",
    "@kaligula/db": "0.4.0",
    "@kaligula/domain": "0.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
