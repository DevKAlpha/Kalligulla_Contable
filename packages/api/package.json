{
  "name": "@kaligula/api",
  "version": "0.4.0",
  "private": true,
  "description": "API HTTP (Hono) en módulos hexagonales con persistencia en PostgreSQL/PGlite. Se monta en Next.js o corre sola en Node/Bun.",
